{
  "kind": "collectionType",
  "collectionName": "property_cities",
  "info": {
    "singularName": "property-city",
    "pluralName": "property-cities",
    "displayName": "PropertyCity",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "city": {
      "type": "string"
    },
    "property_towns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::property-town.property-town",
      "mappedBy": "property_city"
    },
    "properties": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::property.property",
      "mappedBy": "property_city"
    },
    "slug": {
      "type": "uid",
      "targetField": "city"
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": true,
      "component": "seo.seo"
    },
    "meta": {
      "type": "component",
      "repeatable": true,
      "component": "seo.seo"
    },
    "latitude": {
      "type": "float",
      "default": 0
    },
    "longitude": {
      "type": "float",
      "default": 0
    }
  }
}
