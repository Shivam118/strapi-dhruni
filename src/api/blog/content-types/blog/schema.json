{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "blog",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "caption": {
      "type": "string"
    },
    "authorEmail": {
      "type": "email",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    },
    "tags": {
      "type": "json"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Market Insights",
        "Buyer's Guide",
        "Destinations",
        "Investment",
        "Lifestyle"
      ]
    },
    "ogImage": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    }
  }
}
